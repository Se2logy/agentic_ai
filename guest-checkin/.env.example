# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://guestcheckin:guestcheckin@localhost:3306/guestcheckin

# ── LLM (Ollama) ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── SMTP ──────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=checkin@guestapp.local

# ── File uploads ──────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ── Secure links ──────────────────────────────────────────────────
LINK_SECRET=change-me-in-production
LINK_EXPIRY_HOURS=1

# ── Authentication ────────────────────────────────────────────────
API_KEY_HEADER=X-API-Key

# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT=60/minute

# ── CORS (comma-separated origins) ────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
