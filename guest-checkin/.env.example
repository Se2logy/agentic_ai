# ── Database ──────────────────────────────────────────────────────
# SQLAlchemy async connection string.
# For development with Docker: mysql+pymysql://guestcheckin:guestcheckin@localhost:3306/guestcheckin
DATABASE_URL=mysql+pymysql://guestcheckin:guestcheckin@localhost:3306/guestcheckin

# ── LLM (Ollama) ─────────────────────────────────────────────────
# Base URL of the Ollama API server.
OLLAMA_BASE_URL=http://localhost:11434
# Model name used for intent detection, entity extraction, and chat.
OLLAMA_MODEL=llama3.1:8b

# ── Email (SMTP) ─────────────────────────────────────────────────
# SMTP server hostname. Use "mailhog" for Docker, "localhost" for local MailHog.
SMTP_HOST=localhost
# SMTP server port. MailHog default is 1025 (no TLS).
SMTP_PORT=1025
# SMTP credentials. Leave empty for MailHog (no auth required).
SMTP_USER=
SMTP_PASS=your-secret-here
# Email address shown in the From header for guest check-in emails.
SMTP_FROM=checkin@guestapp.local

# ── File Uploads ─────────────────────────────────────────────────
# Directory where uploaded ID documents are stored.
UPLOAD_DIR=/app/uploads

# ── Secure Links ─────────────────────────────────────────────────
# HMAC secret for signing time-limited links (e.g. ID upload, incidental selection).
# Auto-generated at startup if not set. Set explicitly in production for
# cross-instance consistency so links issued by one instance validate on another.
LINK_SECRET=change-me-in-production
# Number of hours after which a signed link expires.
LINK_EXPIRY_HOURS=1

# ── Authentication ───────────────────────────────────────────────
# HTTP header name that carries the platform API key.
API_KEY_HEADER=X-API-Key
# Number of hours a guest session token remains valid (absolute expiry from creation).
SESSION_TOKEN_EXPIRY_HOURS=24

# ── Rate Limiting ────────────────────────────────────────────────
# Rate limit for API requests, expressed as "count/period" (e.g. "60/minute").
RATE_LIMIT=60/minute

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing.
# JSON-serialized list format is also accepted by pydantic-settings.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
